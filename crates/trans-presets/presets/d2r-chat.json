    { "foreign": "WTT", "user": "交换" },
    { "foreign": "pm", "user": "私聊" },
    { "foreign": "gg", "user": "打得不错" },
    { "foreign": "brb", "user": "马上回来" },
    { "foreign": "Enigma", "user": "谜团" },
    { "foreign": "Ber", "user": "Ber 符文" },
    { "foreign": "baal run", "user": "刷巴尔" }
  ]
